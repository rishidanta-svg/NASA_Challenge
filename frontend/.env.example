# Copy to .env.local to override. All values are optional.

# FastAPI backend origin (data agent). The UI works without it: endpoints that
# fail fall back to clearly labeled MOCK data or "awaiting data" states.
VITE_API_BASE_URL=http://localhost:8000

# Live environment source while FastAPI /api/environment/latest is unavailable.
#   auto   = try FastAPI first, then NOAA CO-OPS directly (default)
#   noaa   = always NOAA CO-OPS directly from the browser
#   api    = FastAPI only (no direct NOAA fallback)
VITE_ENVIRONMENT_SOURCE=auto

# NOAA CO-OPS station for direct browser fallback (Duck, NC)
VITE_NOAA_STATION=8651370
